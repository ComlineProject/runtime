# Generated by Cargo
# will have compiled files and executables
debug/
target/

# The workspace's Cargo.lock is committed: it builds binaries (comline-reference,
# the C ABI's libraries and its .wasm), and those must build the same bytes from
# the same revision. The fuzz crate is outside the workspace and keeps its own,
# unpinned.
/runtime/fuzz/Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb


# Jetbrains IDEA project settings
.idea/

# Development temporary directory
__TEMP__/

# TODO: This exclusion might be temporary, or the directory in this
#       location might move to elsewhere
# Development test data directory
__TEST_DATA__/
