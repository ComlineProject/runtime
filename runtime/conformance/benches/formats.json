    {
      "id": "large-array",
      "description": "1000 small structs in one array; element i is {x: 7i - 3500, y: 13i mod 1000, z: -i, weight: 31i mod 65536}.",
      "type": {"array": {"struct": {"name": "Sample", "fields": [["x", "i32"], ["y", "i32"], ["z", "i32"], ["weight", "u16"]]}}},
      "value": {
        "generate": {
          "count": 1000,
          "item": {"struct": {"name": "Sample", "fields": [
            ["x", {"i32": {"start": -3500, "step": 7}}],
            ["y", {"i32": {"start": 0, "step": 13, "modulo": 1000}}],
            ["z", {"i32": {"start": 0, "step": -1}}],
            ["weight", {"u16": {"start": 0, "step": 31, "modulo": 65536}}]
          ]}}
        }
      }
    },
    {
      "id": "enum-heavy",
      "description": "Unit-variant enums: three fields, an option, and two lists of them.",
      "type": {
        "struct": {
          "name": "Job",
          "fields": [
            ["status", {"enum": {"name": "Status", "variants": ["Queued", "Running", "Paused", "Succeeded", "Failed", "Cancelled"]}}],
