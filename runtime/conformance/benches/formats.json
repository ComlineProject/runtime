{
  "$schema": "../specs/gen/bench.schema.json",
  "formats": ["json@1", "msgpack@1", "packed@1"],
  "shapes": [
    {
      "id": "small-scalar",
      "description": "A struct of five fixed-width scalars: the cheapest message.",
      "type": {"struct": {"name": "Reading", "fields": [["id", "u32"], ["channel", "u16"], ["active", "bool"], ["value", "f64"], ["offset", "i64"]]}},
      "value": {
        "struct": {
          "name": "Reading",
          "fields": [["id", {"u32": 48213}], ["channel", {"u16": 7}], ["active", {"bool": true}], ["value", {"f64": 21.5}], ["offset", {"i64": "-1250000"}]]
        }
      }
    },
    {
      "id": "string-heavy",
      "description": "Mostly text: five strings and a list of six, with non-ASCII characters, a quote and a newline to escape.",
      "type": {
        "struct": {
          "name": "Profile",
          "fields": [
            ["username", "string"],
            ["display_name", "string"],
            ["email", "string"],
            ["bio", "string"],
            ["locale", "string"],
            ["tags", {"array": "string"}]
          ]
        }
      },
      "value": {
        "struct": {
          "name": "Profile",
          "fields": [
            ["username", {"string": "ada.lovelace"}],
            ["display_name", {"string": "Ada Lovelace — \"The Enchantress of Numbers\""}],
            ["email", {"string": "ada.lovelace@analytical-engine.example"}],
            [
              "bio",
              {
                "string": "Mathematician and writer, chiefly known for her work on Charles Babbage's proposed mechanical general-purpose computer, the Analytical Engine. She was the first to recognise that the machine had applications beyond pure calculation.\nNotes: A–G, 1843."
              }
            ],
            ["locale", {"string": "en-GB"}],
            [
              "tags",
              {
                "array": [
                  {"string": "mathematics"},
                  {"string": "computing"},
                  {"string": "poetical science"},
                  {"string": "analytical engine"},
                  {"string": "bernoulli numbers"},
                  {"string": "née Byron"}
                ]
              }
            ]
          ]
        }
      }
    },
    {
      "id": "nested",
      "description": "Structs three deep, with options both present and absent at each level.",
      "type": {
        "struct": {
          "name": "Order",
          "fields": [
            ["id", "u64"],
            [
              "customer",
              {
                "struct": {
                  "name": "Customer",
                  "fields": [
                    ["id", "u32"],
                    ["name", "string"],
                    [
                      "address",
                      {
                        "option": {
                          "struct": {
                            "name": "Address",
                            "fields": [["street", "string"], ["city", "string"], ["postcode", {"option": "string"}], ["country", "u16"]]
                          }
                        }
                      }
                    ]
                  ]
                }
              }
            ],
            [
              "shipping",
              {
                "option": {
                  "struct": {"name": "Address", "fields": [["street", "string"], ["city", "string"], ["postcode", {"option": "string"}], ["country", "u16"]]}
                }
              }
            ],
            [
              "billing",
              {
                "option": {
                  "struct": {"name": "Address", "fields": [["street", "string"], ["city", "string"], ["postcode", {"option": "string"}], ["country", "u16"]]}
                }
              }
            ],
            [
              "line",
              {
                "struct": {
                  "name": "Line",
                  "fields": [
                    ["sku", "u32"],
                    ["quantity", "u16"],
                    ["price", {"option": {"struct": {"name": "Price", "fields": [["cents", "i64"], ["discount", {"option": "u8"}]]}}}]
                  ]
                }
              }
            ],
            ["note", {"option": "string"}],
            ["gift", {"option": {"struct": {"name": "Gift", "fields": [["from", {"option": "string"}], ["wrapped", "bool"]]}}}]
          ]
        }
      },
      "value": {
        "struct": {
          "name": "Order",
          "fields": [
            ["id", {"u64": "9007199254740993"}],
            [
