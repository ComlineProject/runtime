            ["history", {"array": {"enum": {"name": "Status", "variants": ["Queued", "Running", "Paused", "Succeeded", "Failed", "Cancelled"]}}}],
            ["kinds", {"array": {"enum": {"name": "Kind", "variants": ["Build", "Test", "Lint", "Bench", "Deploy", "Release", "Docs", "Fuzz"]}}}]
          ]
        }
