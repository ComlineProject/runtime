{
    "guarantees": {
        "schema_agreement": {
            "status": "stable",
            "title": "schema agreement",
            "description": "Both ends were built from compatible schemas, which the handshake checks.",
            "comes_from": "handshake",
            "scopes": [
                "package",
                "protocol"
            ]
        },
        "encoding_agreement": {
            "status": "stable",
            "title": "encoding agreement",
            "description": "Both ends use the same format and framing, which the handshake checks.",
            "comes_from": "handshake",
            "scopes": [
                "package",
                "protocol"
            ]
        },
        "encoding_conformance": {
            "status": "stable",
            "title": "encoding conformance",
            "description": "An implementation encodes what its name promises, proven by conformance vectors.",
            "comes_from": "encoding",
            "scopes": [
                "package",
                "protocol"
            ]
        },
        "version_honesty": {
            "status": "stable",
            "title": "version honesty",
            "description": "A version bump says what the change breaks, as the version comparison works it out.",
            "comes_from": "policy",
            "scopes": [
                "package",
                "protocol"
            ]
        },
        "bounded_size": {
            "status": "stable",
            "title": "bounded size",
            "description": "Every value has a maximum size, so a decoder refuses an oversized one before allocating it.",
            "comes_from": "type",
            "scopes": [
                "protocol",
                "function",
                "argument",
                "field",
                "type"
            ]
        }
    },
    "facts": {
        "struct_fields": {
            "applies_to": "format",
            "status": "stable",
            "title": "struct fields",
            "description": "How a struct's fields are written.",
            "values": {
                "by_position": "back to back, in declaration order",
                "by_name": "each keyed by its name"
            }
        },
        "unknown_field": {
            "applies_to": "format",
            "status": "stable",
            "title": "unknown field",
            "description": "What a reader does with a field its type doesn't have.",
            "values": {
                "rejected": "refuses the value",
                "ignored": "skips the field"
            }
        },
        "missing_optional": {
            "applies_to": "format",
            "status": "stable",
            "title": "missing optional",
            "description": "What a reader does when an optional field isn't there.",
            "values": {
                "rejected": "refuses the value",
                "absent": "reads it as absent"
            }
        },
        "enum_variants": {
            "applies_to": "format",
            "status": "stable",
            "title": "enum variants",
            "description": "How an enum's variant is written.",
            "values": {
                "by_name": "by its name",
                "by_index": "by its position in the declaration"
            }
        },
        "unknown_variant": {
            "applies_to": "format",
            "status": "stable",
            "title": "unknown variant",
            "description": "What a reader does with a variant its type doesn't have.",
            "values": {
                "rejected": "refuses the value",
                "tolerated": "reads it without failing"
            }
        },
        "integer_width": {
            "applies_to": "format",
            "status": "stable",
            "title": "integer width",
            "description": "Whether an integer reads into another width.",
            "values": {
                "by_value": "any width the value fits",
                "exact": "only the width it was written as"
            }
        },
        "output": {
            "applies_to": "format",
            "status": "stable",
            "title": "output",
            "description": "The grammar a format writes in, which a framing's `payload` must take.",
            "since": "0.7",
            "values": {
                "bytes": "bytes in no grammar a framing reads",
                "json": "JSON text"
            }
        },
        "calls": {
            "applies_to": "framing",
            "status": "stable",
            "title": "calls",
            "description": "How a request names the function it calls.",
            "values": {
                "by_index": "by the function's position",
                "by_name": "by the function's name",
                "by_id": "by the protocol's and function's wire numbers"
            }
        },
        "directions": {
            "applies_to": "framing",
            "status": "stable",
            "title": "directions",
            "description": "Whether a frame says if it's a request or a response.",
            "since": "0.10",
            "values": {
                "both": "it does, so calls can go both ways on one transport",
                "one": "it doesn't"
            }
        },
        "errors": {
            "applies_to": "framing",
            "status": "stable",
            "title": "errors",
            "description": "How an error response names its error.",
            "values": {
                "by_ordinal": "by its position in the declaration",
                "by_name": "by its name"
            }
        },
        "payload": {
            "applies_to": "framing",
            "status": "stable",
            "title": "payload",
            "description": "What a framing needs of a payload, which a format's `output` must fit.",
            "since": "0.7",
            "values": {
                "opaque": "any bytes, carried as they are",
                "json": "JSON text, written into the frame"
            }
        },
        "schema_agreement": {
            "applies_to": "handshake",
            "status": "stable",
            "title": "schema agreement",
            "description": "Whether the handshake checks both ends were built from compatible schemas.",
            "since": "0.2",
            "establishes": "schema_agreement",
            "values": {
                "true": "it does, and refuses a peer that wasn't",
                "false": "it doesn't"
            }
        },
        "encoding_agreement": {
            "applies_to": "handshake",
            "status": "stable",
            "title": "encoding agreement",
            "description": "Whether the handshake checks both ends use the same format and framing.",
            "since": "0.2",
            "establishes": "encoding_agreement",
            "values": {
                "true": "it does, and refuses a peer that doesn't",
                "false": "it doesn't"
            }
        }
    },
