{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "description": "`features.json`: the wire features, with stable ids.",
    "additionalProperties": false,
    "properties": {
        "$schema": {
            "type": "string"
        },
        "features": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "description": {
                        "type": "string"
                    },
                    "id": {
                        "type": "string"
                    },
                    "title": {
                        "type": "string"
                    }
                },
                "required": [
                    "description",
                    "id",
                    "title"
                ]
            }
        }
    },
    "required": [
        "features"
    ]
}
